# Producción. Copia como .env en el servidor:  cp .env.production.example .env
# Todas las variables sin valor por defecto son obligatorias; el sistema no arranca sin ellas.

# Dominio apuntando a la IP del servidor (registro DNS tipo A)
DOMINIO=citas.tuclinica.co
CORREO_TLS=sistemas@tuclinica.co

# Genera cada secreto con:  openssl rand -base64 48
DB_PASSWORD=
JWT_KEY=

# Primer administrador. La contraseña es temporal: el sistema obliga a cambiarla en el primer ingreso.
ADMIN_EMAIL=admin@tuclinica.co
ADMIN_PASSWORD_TEMPORAL=

# Datos que aparecen en los mensajes de WhatsApp
CLINICA_NOMBRE=Clínica Dental Alameda
CLINICA_DIRECCION="Calle 00 # 00-00, consultorio 201"

# Respaldos: hora del día (00-23, hora Colombia) y días que se conservan
HORA_BACKUP=02
RETENCION_DIAS=30

# WhatsApp (ver docs/WHATSAPP.md). Deja Consola hasta tener las plantillas aprobadas.
WHATSAPP_PROVEEDOR=Consola
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_PLANTILLA_CONFIRMACION=
TWILIO_PLANTILLA_CANCELACION=
